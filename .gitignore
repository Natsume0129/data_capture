# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# Local Python environments
.venv*/
venv/
env/
ENV/

# Build and packaging output
/build/
/dist/
/debug_build/
/debug_dist/
*.spec
*.exe

# Runtime data: never commit participant recordings or derived clips
/data/
/raw/
/clips/
/logs/
/tts_cache/
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.wav
events.jsonl
manifest.csv
session.json
stimuli.json

# Google Cloud credentials and local secrets
.env
.env.*
!.env.example
/secrets/
credentials.json
google-credentials*.json
service-account*.json
service_account*.json

# Local diagnostics and visual QA output
/*self_check*.json
/ui_*.png
/tmp/
*.log
*.tmp
*.part

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Office lock files that may appear beside question-set CSV files
~$*
